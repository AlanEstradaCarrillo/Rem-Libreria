{
  "name": "@libra-pos/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de Librería REM.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 test/integration/*.test.js",
    "db:init": "node src/scripts/init-db.js",
    "db:migrate": "node src/scripts/migrate-db.js",
    "db:seed": "node src/scripts/seed-db.js",
    "db:setup": "npm run db:init && npm run db:seed",
    "ops:backup-restore": "node src/scripts/backup-restore-check.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
