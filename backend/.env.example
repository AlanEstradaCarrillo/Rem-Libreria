# PostgreSQL local
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_PASSWORD@localhost:5432/libra_pos

# Usa 1 únicamente si el proveedor de PostgreSQL exige TLS/SSL.
PGSSL=0

# Genera un valor largo y aleatorio; no reutilices este ejemplo.
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
JWT_EXPIRES=8h

# Contraseñas iniciales. Deben tener entre 12 y 72 caracteres.
# Se usan solo al crear cada usuario por primera vez.
SEED_ADMIN_PASSWORD=CAMBIA_POR_UNA_CLAVE_ADMIN_SEGURA
SEED_CASHIER_PASSWORD=CAMBIA_POR_UNA_CLAVE_CAJA_SEGURA

# Express usa 4000 localmente. Zeabur inyecta PORT automáticamente.
PORT=4000

# Opcional. Si se omite, la API queda disponible únicamente para el mismo origen.
# Varias direcciones externas autorizadas se separan por coma, sin espacios.
# CORS_ORIGIN=http://localhost:4000

# En Zeabur configura 1 para interpretar correctamente la IP tras el proxy.
TRUST_PROXY=0

# Ruta del registro persistente de errores. Configura un volumen persistente
# o el mecanismo de logs del proveedor; no incluyas este archivo en Git.
ERROR_LOG_FILE=logs/errors.log

# Tiempo durante el que un pedido mantiene reservadas sus existencias.
# Debe ser un entero entre 5 y 1440 minutos.
RESERVATION_TTL_MINUTES=30

# Opcional. Número de WhatsApp de la librería en formato internacional,
# solo dígitos y sin el signo +. Ejemplo ficticio para México:
# STORE_WHATSAPP_NUMBER=5210000000000
